# Salin menjadi .env lalu sesuaikan
PORT=3000
# true = pakai broker MQTT bawaan (port 1883), cocok untuk lokal.
# false = pakai broker eksternal (Mosquitto/EMQX) di MQTT_URL.
EMBEDDED_BROKER=true
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=
MQTT_PASS=
# Perangkat dianggap offline jika tidak mengirim data selama N detik
OFFLINE_SECONDS=15
